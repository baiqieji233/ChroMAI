diff --git a/src/core/scene/PreviewHandTint.h b/src/core/scene/PreviewHandTint.h
new file mode 100644
index 0000000000000000000000000000000000000000..fd12d17619dc0b725b209068f9979b0ff97f153d
--- /dev/null
+++ b/src/core/scene/PreviewHandTint.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <QImage>
+#include <cmath>
+#include <map>
+#include <utility>
+#include "core/chart/model/TimelineData.h"
+
+namespace miacode::preview::scene {
+
+inline int handTrackColor(const TimelineNoteMarker& marker, double at)
+{
+    int tint = marker.previewHandTrack;
+    for (const auto& [second, side] : marker.previewHandChanges) {
+        if (second > at) break;
+        tint = side;
+    }
+    return tint;
+}
+
+inline int handSplitColor(int first, int second, qreal direction, bool vertical = false)
+{
+    if (first == second) return first;
+    if (direction < 0) std::swap(first, second);
+    // A 0 half preserves that half of the original texture.
+    return 3 + (vertical ? 9 : 0) + first * 3 + second;
+}
+
+inline int handWifiColor(const TimelineNoteMarker& marker, qreal degrees)
+{
+    if (marker.wifiLanePoints.size() < 2 || marker.wifiLanePoints.first().isEmpty()
+        || marker.wifiLanePoints.last().isEmpty())
+        return 0;
+    const QPointF span = marker.wifiLanePoints.last().last() - marker.wifiLanePoints.first().last();
+    const qreal phi = degrees * 0.017453292519943295;
+    const qreal x = std::cos(phi), y = std::sin(phi);
+    const qreal horizontal = span.x() * x + span.y() * y;
+    const qreal vertical = span.y() * x - span.x() * y;
+    if (std::abs(horizontal) >= std::abs(vertical))
+        return handSplitColor(marker.previewHandTrack, marker.previewHandTrackOther, horizontal);
+    return handSplitColor(marker.previewHandTrack, marker.previewHandTrackOther, vertical, true);
+}
+
+inline const QImage* handTintImage(const QImage* source, int tint)
+{
+    if (!source || source->isNull() || tint <= 0 || tint >= 21) return source;
+    // Only static skin assets or the existing cached EX composites reach this cache.
+    // std::map keeps texture pointers stable as additional assets are first used.
+    static std::map<std::pair<qint64, int>, QImage> images;
+    const auto key = std::make_pair(source->cacheKey(), tint);
+    auto found = images.find(key);
+    if (found != images.end()) return &found->second;
+    QImage image = source->convertToFormat(QImage::Format_ARGB32);
+    const QRgb colors[] = {qRgb(60, 167, 255), qRgb(255, 141, 51)};
+    for (int y = 0; y < image.height(); ++y) {
+        auto* row = reinterpret_cast<QRgb*>(image.scanLine(y));
+        for (int x = 0; x < image.width(); ++x) {
+            const QRgb pixel = row[x];
+            if (!qAlpha(pixel)) continue;
+            int side = tint;
+            if (tint >= 3) {
+                const int halves = (tint - 3) % 9;
+                const bool second = tint >= 12 ? 2 * y >= image.height() : 2 * x >= image.width();
+                side = second ? halves % 3 : halves / 3;
+            }
+            if (!side) continue;
+            const QRgb color = colors[side - 1];
+            const int value = qMax(qRed(pixel), qMax(qGreen(pixel), qBlue(pixel)));
+            const int light = qBound(0, (qMin(qRed(pixel), qMin(qGreen(pixel), qBlue(pixel))) - 180) * 65 / 75, 65);
+            const auto channel = [value, light](int c) {
+                return (c * value + (255 - c) * light * value / 255) / 255;
+            };
+            row[x] = qRgba(channel(qRed(color)), channel(qGreen(color)), channel(qBlue(color)), qAlpha(pixel));
+        }
+    }
+    auto saved = images.emplace(key, image.convertToFormat(QImage::Format_ARGB32_Premultiplied));
+    return &saved.first->second;
+}
+
+}
